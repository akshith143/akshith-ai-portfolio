# --- Claude (required for the AI to answer) ---
ANTHROPIC_API_KEY=
# Model + effort. Lower effort = faster first word. Opus 5.5 at "low" is the default.
PORTFOLIO_MODEL=claude-opus-5-5
PORTFOLIO_EFFORT=low

# --- Your cloned voice (ElevenLabs). Without these the browser's built-in voice is used. ---
# The API key also powers speech-to-text for Brave/Firefox visitors.
ELEVENLABS_API_KEY=
# Run `npm run clone-voice` after dropping recordings into voice-samples/ to get this id.
ELEVENLABS_VOICE_ID=
# Flash is ElevenLabs' lowest-latency model (~75ms model time).
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Server ---
PORT=8787
# Requests per IP per minute for /api/chat (TTS gets 4x this)
RATE_LIMIT_PER_MIN=20
# Optional: GitHub token to avoid the 60 req/hr unauthenticated limit
GITHUB_TOKEN=
